# Copy this file to .env and fill in real values. Never commit .env (already gitignored).

# Primary DB connection. Use the Supabase Session Pooler URL (not the Transaction Pooler,
# port 6543 -- it doesn't reliably support DDL/Alembic or psycopg3 prepared statements).
# Always copy the exact string from the Supabase dashboard's Connect dialog.
SCOUT_IT_DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Local development fallback (optional, requires a local Postgres via pg_ctl -- see README):
# SCOUT_IT_DATABASE_URL=postgresql+psycopg://scout_it:scout_it@localhost:5432/scout_it

# Optional second target for tools that address Supabase explicitly regardless of the
# primary connection above (e.g. `python -m scripts.data_visualizer --target supabase`).
# SCOUT_IT_SUPABASE_DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
